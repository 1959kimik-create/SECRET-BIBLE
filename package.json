{
  "name": "secret-bible",
  "version": "0.1.0",
  "private": true,
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "assets:ensure": "node scripts/ensure-assets.mjs",
    "postinstall": "node scripts/ensure-assets.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "predev:electron": "node scripts/predev.mjs",
    "electron:dev": "npm run build:electron && npm run predev:electron && concurrently -k \"next dev -p 3000 --webpack\" \"wait-on http://127.0.0.1:3000 && node scripts/launch-electron.mjs\"",
    "electron:app": "npm run build:electron && node scripts/predev.mjs && npm run build && concurrently -k \"next start -p 3000\" \"wait-on http://127.0.0.1:3000 && node scripts/launch-electron.mjs\"",
    "smoke:ffmpeg": "tsx scripts/smoke-ffmpeg.ts",
    "smoke:video": "tsx scripts/smoke-video.ts",
    "bible:fetch": "node scripts/fetch-bible-krv.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@napi-rs/canvas": "^1.0.9",
    "electron": "^44.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
